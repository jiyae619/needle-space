# Browser-exposed (safe when properly scoped)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
# Map only. Public by design: restrict it to your site's domains and the
# Maps JavaScript API. Replaces the deprecated NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your-google-maps-browser-key

# Server/scripts only (never expose client-side)
GOOGLE_PLACES_SERVER_KEY=your-google-places-server-key   # the only key the data scripts use
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
VOYAGE_API_KEY=your-voyage-key          # query + cafe embeddings
GEMINI_API_KEY=your-gemini-key          # LLM + vision tagging (scripts only)
TAVILY_API_KEY=your-tavily-key          # web research (scripts only)

# Enables /admin in deployed builds behind HTTP Basic auth. Unset = /admin
# works only under `npm run dev` (see src/proxy.ts).
ADMIN_PASSWORD=

# Optional: hide semantic results below this cosine similarity (e.g. 0.35).
# Leave unset until nl_query_log.top_similarity shows where weak matches start.
SEARCH_MIN_SIMILARITY=
